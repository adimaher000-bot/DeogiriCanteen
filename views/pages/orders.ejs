<%- include('../partials/header') %>

    <div class="orders-page-wrapper">
        <div class="container main-orders-container">

            <div class="section-title text-center" style="margin-bottom: 50px;">
                <h2>Your Orders</h2>
                <p>Track your food journey here.</p>
            </div>

            <!-- Tabs -->
            <div class="tabs-container"
                style="display: flex; gap: 20px; margin-bottom: 30px; border-bottom: 2px solid #eee;">
                <button class="tab-btn active" onclick="switchTab('orders')">Food Orders</button>
                <button class="tab-btn" onclick="switchTab('bookings')">Table Bookings</button>
            </div>

            <!-- Orders Tab Content -->
            <div id="orders-tab" class="tab-content active">
                <% if (orders.length> 0) { %>
                    <div class="orders-list">
                        <% orders.forEach(order=> { %>
                            <div class="order-card glass-card">

                                <div class="order-header">
                                    <div class="order-id">
                                        <span class="label">ORDER ID</span>
                                        <span class="value">#<%= order._id.toString().slice(-6).toUpperCase() %></span>
                                    </div>
                                    <div class="order-date">
                                        <i class="far fa-clock"></i>
                                        <%= new Date(order.createdAt).toLocaleDateString() %>
                                            <%= new Date(order.createdAt).toLocaleTimeString([], {hour: '2-digit' ,
                                                minute:'2-digit'}) %>
                                    </div>
                                </div>

                                <div class="order-body">
                                    <div class="order-items-summary">
                                        <% order.items.forEach(item=> { %>
                                            <div class="summary-item">
                                                <span class="qty">
                                                    <%= item.quantity %>x
                                                </span>
                                                <span class="name">
                                                    <%= item.menu_item ? item.menu_item.item_name : 'Item Unavailable'
                                                        %>
                                                </span>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <div class="order-meta">
                                        <!-- Order Type Badge -->
                                        <% if (order.order_type==='delivery' ) { %>
                                            <span class="type-badge delivery"><i class="fas fa-truck"></i>
                                                Delivery</span>
                                            <% } else { %>
                                                <span class="type-badge pickup"><i class="fas fa-shopping-bag"></i>
                                                    Pickup</span>
                                                <% } %>

                                                    <!-- Status Badge -->
                                                    <span
                                                        class="status-badge <%= order.status.toLowerCase().replace(/\s/g, '-') %>">
                                                        <%= order.status %>
                                                    </span>
                                    </div>
                                </div>

                                <div class="order-footer">
                                    <div class="total-amount">
                                        <span class="label">Total</span>
                                        <span class="amount">₹<%= order.total_amount %></span>
                                    </div>

                                    <% if (order.status==='Pending' ) { %>
                                        <div class="actions">
                                            <button class="btn btn-outline-danger btn-sm cancel-btn"
                                                onclick="cancelOrder('<%= order._id %>')">
                                                Cancel Order
                                            </button>
                                        </div>
                                        <% } %>
                                </div>

                                <!-- Progress Bar Enhancement (Visual Only) -->
                                <% if (order.status !=='Cancelled' ) { %>
                                    <div class="order-progress">
                                        <div class="progress-bar <%= order.status.toLowerCase() %>"></div>
                                    </div>
                                    <% } %>
                            </div>
                            <% }) %>
                    </div>
                    <% } else { %>
                        <div class="empty-state">
                            <img src="/images/empty-orders.svg" onerror="this.style.display='none'" alt="">
                            <h3>No Orders Yet</h3>
                            <p>You haven't placed any orders yet. Hungry?</p>
                            <a href="/menu" class="btn btn-primary">Browse Menu</a>
                        </div>
                        <% } %>
            </div>

            <!-- Bookings Tab Content -->
            <div id="bookings-tab" class="tab-content" style="display: none;">
                <% if (typeof bookings !=='undefined' && bookings.length> 0) { %>
                    <div class="bookings-grid"
                        style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
                        <% bookings.forEach(booking=> { %>
                            <div class="booking-card glass-card"
                                style="background: white; border-radius: 12px; padding: 20px; position: relative; border: 1px solid rgba(0,0,0,0.05);">

                                <div class="booking-status <%= booking.status.toLowerCase() %>"
                                    style="position: absolute; top: 15px; right: 15px; padding: 5px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: bold; text-transform: uppercase;">
                                    <%= booking.status %>
                                </div>

                                <div class="booking-date" style="margin-bottom: 15px;">
                                    <div style="font-size: 1.5rem; font-weight: 700; color: #333; line-height: 1;">
                                        <%= new Date(booking.date).getDate() %>
                                    </div>
                                    <div
                                        style="font-size: 0.85rem; color: var(--primary); text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">
                                        <%= new Date(booking.date).toLocaleString('default', { month: 'short' }) %>
                                            <%= new Date(booking.date).getFullYear() %>
                                    </div>
                                </div>

                                <div class="booking-details">
                                    <div
                                        style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px; color: #555;">
                                        <i class="far fa-clock" style="color: #888;"></i>
                                        <span>
                                            <%= booking.time %>
                                        </span>
                                    </div>
                                    <div
                                        style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px; color: #555;">
                                        <i class="fas fa-user-friends" style="color: #888;"></i>
                                        <span>
                                            <%= booking.guests %> Guests
                                        </span>
                                    </div>
                                    <% if(booking.special_request) { %>
                                        <div
                                            style="margin-top: 10px; padding: 10px; background: #fff8e1; border-radius: 6px; font-size: 0.85rem; font-style: italic; color: #8d6e63;">
                                            "<%= booking.special_request %>"
                                        </div>
                                        <% } %>
                                </div>

                            </div>
                            <% }) %>
                    </div>
                    <% } else { %>
                        <div class="empty-state">
                            <div style="font-size: 3rem; color: #eee; margin-bottom: 10px;"><i
                                    class="fas fa-calendar-times"></i></div>
                            <h3>No Bookings Yet</h3>
                            <p>You haven't booked any tables.</p>
                            <a href="#" onclick="openBookingModal(); return false;" class="btn btn-primary">Book a
                                Table</a>
                        </div>
                        <% } %>
            </div>

            <script>
                function switchTab(tabName) {
                    // Hide all
                    document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
                    document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));

                    // Show target
                    document.getElementById(tabName + '-tab').style.display = 'block';
                    // Activate btn (simple fix, assumed order)
                    if (tabName === 'orders') document.querySelector('.tab-btn:first-child').classList.add('active');
                    if (tabName === 'bookings') document.querySelector('.tab-btn:last-child').classList.add('active');
                }
            </script>

            <style>
                .tab-btn {
                    background: none;
                    border: none;
                    padding: 10px 20px;
                    font-size: 1.1rem;
                    font-weight: 600;
                    color: #888;
                    cursor: pointer;
                    border-bottom: 3px solid transparent;
                    transition: 0.2s;
                }

                .tab-btn:hover {
                    color: #555;
                }

                .tab-btn.active {
                    color: var(--primary);
                    border-bottom-color: var(--primary);
                }

                .booking-status.pending {
                    background: #fff3e0;
                    color: #ef6c00;
                }

                .booking-status.confirmed {
                    background: #e8f5e9;
                    color: #2e7d32;
                }

                .booking-status.rejected {
                    background: #ffebee;
                    color: #c62828;
                }

                .booking-status.cancelled {
                    background: #eceff1;
                    color: #607d8b;
                }
            </style>

        </div>
    </div>

    <style>
        .orders-page-wrapper {
            padding-top: 120px;
            padding-bottom: 80px;
            background: #f8f9fa;
            min-height: 100vh;
        }

        .main-orders-container {
            max-width: 900px;
        }

        .orders-list {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .order-card {
            background: white;
            border-radius: 16px;
            padding: 0;
            overflow: hidden;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
            transition: transform 0.2s;
        }

        .order-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        }

        .order-header {
            background: #fdfdfd;
            padding: 15px 25px;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .order-id .label {
            font-size: 0.75rem;
            color: #999;
            font-weight: 600;
            margin-right: 5px;
        }

        .order-id .value {
            font-weight: 700;
            color: #333;
            font-family: monospace;
            font-size: 1.1rem;
        }

        .order-date {
            color: #888;
            font-size: 0.9rem;
        }

        .order-body {
            padding: 25px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        @media (max-width: 600px) {
            .order-body {
                flex-direction: column;
                gap: 20px;
            }
        }

        .order-items-summary {
            flex: 1;
        }

        .summary-item {
            margin-bottom: 8px;
            font-size: 1rem;
            color: #444;
        }

        .summary-item .qty {
            font-weight: 600;
            margin-right: 10px;
            color: var(--primary);
        }

        .order-meta {
            display: flex;
            flex-direction: column;
            gap: 10px;
            align-items: flex-end;
        }

        /* Badges */
        .type-badge {
            font-size: 0.8rem;
            padding: 5px 12px;
            border-radius: 20px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .type-badge.pickup {
            background: #e3f2fd;
            color: #2196f3;
        }

        .type-badge.delivery {
            background: #fff3e0;
            color: #ff9800;
        }

        .status-badge {
            padding: 6px 16px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-badge.pending {
            background: #fff8e1;
            color: #ffa000;
            border: 1px solid #ffe082;
        }

        .status-badge.preparing {
            background: #e3f2fd;
            color: #1976d2;
            border: 1px solid #bbdefb;
        }

        .status-badge.ready {
            background: #e8f5e9;
            color: #388e3c;
            border: 1px solid #c8e6c9;
        }

        .status-badge.completed {
            background: #f5f5f5;
            color: #616161;
            border: 1px solid #e0e0e0;
        }

        .status-badge.cancelled {
            background: #ffebee;
            color: #d32f2f;
            border: 1px solid #ffcdd2;
        }

        .order-footer {
            padding: 15px 25px;
            background: #fff;
            border-top: 1px solid #f5f5f5;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .total-amount .label {
            font-size: 0.9rem;
            color: #888;
            margin-right: 10px;
        }

        .total-amount .amount {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary);
        }

        .btn-outline-danger {
            border-color: #ffcdd2;
            color: #d32f2f;
        }

        .btn-outline-danger:hover {
            background: #d32f2f;
            color: white;
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }
    </style>

    <script>
        function cancelOrder(orderId) {
            if (!confirm("Are you sure you want to cancel this order? This action cannot be undone.")) return;

            fetch('/order/cancel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ order_id: orderId })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.status === 'success') {
                        alert("Order Cancelled Successfully");
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert("Failed to cancel order");
                });
        }
    </script>

    <%- include('../partials/footer') %>