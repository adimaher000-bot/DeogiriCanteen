<%- include('../partials/header') %>

    <div class="simple-auth-container">
        <h2>Register</h2>
        <% if (errorMessage) { %>
            <div class="error">
                <%= errorMessage %>
            </div>
            <% } %>

                <form action="/register" method="POST">
                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" name="username" class="form-control" required minlength="3" maxlength="20"
                            pattern="[a-zA-Z0-9]+" title="Alphanumeric only, 3-20 chars">
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" name="email" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" name="password" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Role</label>
                        <select name="role" class="form-control" required>
                            <option value="student">Student</option>
                            <option value="teacher">Teacher</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="tel" name="phone" class="form-control" required pattern="[0-9]{10}" maxlength="10"
                            title="Please enter exactly 10 digits"
                            oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                    </div>
                    <button type="submit" class="btn-auth">Register</button>
                </form>
                <p>Already have an account? <a href="/login">Login Here</a></p>
    </div>

    <style>
        .simple-auth-container {
            max-width: 400px;
            margin: 50px auto;
            padding: 30px;
            border: 1px solid #ddd;
            border-radius: 8px;
            text-align: center;
        }

        .form-group {
            margin-bottom: 15px;
            text-align: left;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            background-color: #f9f9f9;
            color: #333;
        }

        .btn-auth {
            width: 100%;
            padding: 10px;
            background: #4ecca3;
            color: white;
            border: none;
            cursor: pointer;
        }

        .error {
            color: red;
            margin-bottom: 15px;
        }
    </style>

    <%- include('../partials/footer') %>